{
  "name": "termx",
  "version": "1.0.0",
  "description": "",
  "main": "src/main/index.cjs",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "npm run build:native && npm run build:renderer",
    "rebuild": "electron-rebuild -f -w node-pty",
    "start": "npm run build && electron --ozone-platform=x11 .",
    "build:native": "node scripts/build-native.cjs",
    "build:swift": "mkdir -p native/macos/lib && swiftc -emit-library -module-name TermXWindow -Xlinker -install_name -Xlinker @loader_path/../../lib/libTermXWindow.dylib -o native/macos/lib/libTermXWindow.dylib native/macos/NativeWindow.swift native/macos/Settings.swift",
    "build:native:macos": "npm run build:swift && node-gyp rebuild --directory native/macos",
    "build:native:linux": "node-gyp rebuild --directory native/linux",
    "build:renderer": "esbuild src/renderer/index.js --bundle --platform=browser --outfile=dist/renderer.js",
    "pack": "npm run build && electron-packager . TermX --platform=darwin --arch=arm64 --out=release --overwrite --prune=true --asar.unpackDir=\"{node_modules/node-pty,native/macos}\" --ignore=\"^/release($|/)\" --ignore=\"^/node_modules/node-pty/prebuilds/win32-\" --ignore=\"^/node_modules/node-pty/prebuilds/darwin-x64($|/)\" --ignore=\"^/node_modules/node-pty/deps/winpty($|/)\" --ignore=\"^/node_modules/node-pty/third_party/conpty($|/)\" --ignore=\"\\.pdb$\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "6.0.0",
    "electron-liquid-glass": "1.1.1",
    "node-addon-api": "^8.9.2",
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@electron/rebuild": "4.2.0",
    "electron": "44.2.0",
    "esbuild": "0.28.2",
    "node-gyp": "^13.0.2"
  },
  "productName": "TermX"
}
